import tkinter as tk
# create main window
window=tk.Tk()
window.title("Machine Traders")
window.geometry("300x200")

# function to handle button click
def on_click():
    label.config(text="Button Clicked")

# create a label
label=tk.Label(window, text="Welcome to Machine Traders")
label.pack(pady=10)

# create an entry field/widgets

entry=tk.Entry(window)
entry.pack(pady=10)

# create a button
button=tk.Button(window, text="Click Me", command=on_click)
button.pack(pady=10)

# run the application
window.mainloop()